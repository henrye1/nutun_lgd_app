# Client database (read-only). Copy to .env and fill in. Never commit .env.
NUTUN_DB_SERVER=192.168.0.55,1495
NUTUN_DB_NAME=Nutun_Audit_2026_July26
NUTUN_DB_AUTH=windows
NUTUN_DB_USER=
NUTUN_DB_PASSWORD=
NUTUN_DB_TRUST_CERT=yes
NUTUN_DB_DRIVER=ODBC Driver 18 for SQL Server
# Local port for start.bat (127.0.0.1 only). Change it if 8000 is already in use on this machine.
NUTUN_PORT=8000
# App run store (SQLite file by default)
NUTUN_RUN_STORE_URL=sqlite:///data/nutun_app.db
